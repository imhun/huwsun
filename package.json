{
  "name": "imhu-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Build scripts for imhun.com (Hugo + Pagefind)",
  "scripts": {
    "build": "hugo --minify && npm run index",
    "index": "rm -rf public/pagefind && pagefind --site public",
    "serve": "hugo server -D --port 1414 --panicOnWarning",
    "preview": "python3 -m http.server 1414 --directory public"
  },
  "devDependencies": {
    "pagefind": "^1.4.0"
  }
}
